# =============================================================================
# Zeyad For Business — backend environment
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is read at startup; nothing in this file is a secret itself.
# =============================================================================

# Environment
PORT=3000

# The public origin, with no trailing slash. Used for canonical URLs, Open
# Graph tags, the sitemap and robots.txt -- so if it is wrong or missing on a
# deployed machine, every one of those points somewhere else. Defaults to
# https://zeyad.store when unset; set it explicitly on the server so a staging
# copy never advertises the production domain.
SITE_URL=https://zeyad.store
# development | production. Under `production` the server refuses to start
# unless SESSION_SECRET and every PG_* setting below are present.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Signs the cookie carrying every admin and customer identity. REQUIRED in
# production -- the server exits rather than fall back to the public default in
# the source tree. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Encrypts stored AI provider credentials. Pinned separately from
# SESSION_SECRET so that rotating the session secret does not make existing
# provider tokens undecryptable. Rotate this ONLY if you are also re-entering
# every AI provider token afterwards.
AI_SECRET_KEY=

# -----------------------------------------------------------------------------
# Database — PostgreSQL is the only database.
#
# There is no SQLite path and no fallback: if PostgreSQL is unreachable the
# application fails loudly rather than serving a second, stale copy of the data.
# All five are REQUIRED when NODE_ENV=production; outside production they fall
# back to the local shadow cluster so development and the tests need no setup.
# -----------------------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# Connection pool ceiling. Keep at or below the server's max_connections
# budget, remembering that each app process opens its own pool.
PG_POOL_MAX=20

# NOTE: PG_SHADOW_HOST / PG_SHADOW_PORT / PG_SHADOW_DATABASE / PG_SHADOW_USER /
# PG_SHADOW_PASSWORD are development-only overrides that take PRECEDENCE over
# the PG_* settings above. Never set them in production -- the server refuses to
# start if it finds one, because a leftover override would silently point the
# deployment at the wrong database while reporting healthy.

# -----------------------------------------------------------------------------
# Schema migrations
#
# Migrations are NOT applied at startup. Deploying code and changing the schema
# are separate, ordered steps, so an application restart can never rewrite the
# schema on its own:
#
#   1. back up the database
#   2. node scripts/migrate.js --dry-run     # review the plan
#   3. node scripts/migrate.js               # apply
#   4. restart the application
#
# The runner records each applied file in schema_migrations, refuses a file that
# was edited after it was applied, and refuses destructive statements outright.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# WhatsApp (optional)
# -----------------------------------------------------------------------------
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_KEY=

# -----------------------------------------------------------------------------
# AI provider credentials (optional — the assistant degrades to a database-only
# fallback when absent, it does not fail)
# -----------------------------------------------------------------------------
AI_PROVIDER=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# First-run admin bootstrap
#
# Used only to create the very first admin account on an empty database. Change
# the password immediately after the first login, and do not leave a real
# password sitting in this file on a deployed machine.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
