          </div>
          <form action="/admin/najm/instructions/reset" method="POST" onsubmit="return confirm('هل أنت متأكد من استعادة التعليمات الافتراضية؟');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" style="background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); padding: 8px 16px; border-radius: 10px; font-weight: 700; cursor: pointer;">
              استعادة الافتراضي
            </button>
          </form>
        </div>

        <form action="/admin/najm/instructions" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">1. هوية الوكيل (Agent Identity)</label>
              <textarea name="agent_identity" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.agent_identity || defaultSections.agent_identity %></textarea>
            </div>
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">2. أسلوب الحديث (Tone & Style)</label>
              <textarea name="tone_and_style" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.tone_and_style || defaultSections.tone_and_style %></textarea>
            </div>
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">3. التعليمات الأساسية وقواعد منع الاختلاق (Core Instructions)</label>
            <textarea name="core_instructions" rows="4" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.core_instructions || defaultSections.core_instructions %></textarea>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">4. سياسة البيع والتوصيات (Sales Policy)</label>
              <textarea name="sales_policy" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.sales_policy || defaultSections.sales_policy %></textarea>
            </div>
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">5. سياسة الأسعار والعملات (Pricing Policy)</label>
              <textarea name="pricing_policy" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.pricing_policy || defaultSections.pricing_policy %></textarea>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">6. سياسة الطلبات والحجز (Orders Policy)</label>
              <textarea name="orders_and_reservation_policy" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.orders_and_reservation_policy || defaultSections.orders_and_reservation_policy %></textarea>
            </div>
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">7. سياسة التحويل للموظف البشري (Human Handoff)</label>
              <textarea name="human_handoff_policy" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.human_handoff_policy || defaultSections.human_handoff_policy %></textarea>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">8. قواعد استخدام الأدوات (Tool Rules)</label>
              <textarea name="tool_rules" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.tool_rules || defaultSections.tool_rules %></textarea>
            </div>
            <div>
              <label style="display: block; color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.9rem; margin-bottom: 6px;">9. قواعد التعامل مع الصور (Vision Rules)</label>
              <textarea name="vision_rules" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.88rem;"><%= instructions.vision_rules || defaultSections.vision_rules %></textarea>
            </div>
          </div>

          <button type="submit" style="display: flex; align-items: center; gap: 8px; padding: 12px 28px; border-radius: 12px; font-weight: 800; background: var(--primary-gold, #c79a52); color: #000; border: none; cursor: pointer;">
            <span class="material-symbols-rounded">save</span>
            حفظ واعتماد التعليمات الجديدة
          </button>
        </form>
      </div>
    <% } %>

    <!-- 4. REQUESTS VIEW (Customer Tickets) -->
    <% if (view === 'requests') { %>
      <div class="glass-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <h2 style="color: #fff; font-size: 1.3rem; margin: 0;">طلبات وتذاكر العملاء (Customer Requests & Human Handoff)</h2>
          <span style="color: #888; font-size: 0.9rem;">الإجمالي: <%= requests.length %> تذكرة</span>
        </div>

        <div class="table-responsive">
          <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: right;">
                <th style="padding: 12px; color: #888;">رقم الطلب</th>
                <th style="padding: 12px; color: #888;">العميل</th>
                <th style="padding: 12px; color: #888;">الهاتف</th>
                <th style="padding: 12px; color: #888;">تفاصيل الطلب</th>
                <th style="padding: 12px; color: #888;">الحالة</th>
                <th style="padding: 12px; color: #888;">التاريخ</th>
                <th style="padding: 12px; color: #888; text-align: center;">إجراءات</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests.length === 0) { %>
                <tr><td colspan="7" style="text-align: center; padding: 40px; color: #888;">لا توجد تذاكر عملاء حتى الآن.</td></tr>
              <% } %>
              <% requests.forEach(r => { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td style="padding: 12px; color: var(--primary-gold, #c79a52); font-weight: 700; font-family: monospace;"><%= r.request_id %></td>
                  <td style="padding: 12px; color: #fff; font-weight: 600;"><%= r.customer_name %></td>
                  <td style="padding: 12px; color: #fff; direction: ltr; text-align: right;"><%= r.phone %></td>
                  <td style="padding: 12px; color: rgba(255,255,255,0.8); max-width: 320px;">
                    <div><%= r.request_text %></div>
                    <% if (r.requested_products) { %>
                      <small style="color: var(--primary-gold, #c79a52);">المنتجات: <%= r.requested_products %></small>
                    <% } %>
                    <% if (r.admin_notes) { %>
                      <div style="color: #22c55e; font-size: 0.8rem; margin-top: 2px;">ملاحظة الإدارة: <%= r.admin_notes %></div>
                    <% } %>
                  </td>
                  <td style="padding: 12px;">
                    <span style="font-size: 0.8rem; padding: 4px 10px; border-radius: 20px; font-weight: 700; background: <%= r.status === 'new' ? 'rgba(239,68,68,0.2)' : (r.status === 'in_review' ? 'rgba(234,179,8,0.2)' : (r.status === 'contacted' ? 'rgba(59,130,246,0.2)' : 'rgba(34,197,94,0.2)')) %>; color: <%= r.status === 'new' ? '#ef4444' : (r.status === 'in_review' ? '#eab308' : (r.status === 'contacted' ? '#3b82f6' : '#22c55e')) %>;">
                      <%= r.statusLabel || r.status %>
                    </span>
                  </td>
                  <td style="padding: 12px; color: #888; font-size: 0.85rem;"><%= helpers.formatDateTime(r.created_at) %></td>
                  <td style="padding: 12px; text-align: center;">
                    <button type="button" onclick="openStatusModal('<%= r.id %>', '<%= r.request_id %>', '<%= r.status %>', '<%= (r.admin_notes || '').replace(/'/g, "\'") %>')" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; cursor: pointer;">
                      تعديل الحالة
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Status Modal -->
      <div id="statusModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #18201b; border: 1px solid var(--primary-gold, #c79a52); border-radius: 16px; padding: 24px; width: 100%; max-width: 480px;">
          <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;" id="modalTitle">تعديل حالة التذكرة</h3>
          <form id="modalStatusForm" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div style="margin-bottom: 16px;">
              <label style="display: block; color: #888; font-size: 0.85rem; margin-bottom: 6px;">الحالة الجديدة</label>
              <select name="status" id="modalStatusSelect" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 10px; border-radius: 10px;">
                <option value="new">جديد (New)</option>
                <option value="in_review">قيد المراجعة (In Review)</option>
                <option value="contacted">تم التواصل مع العميل (Contacted)</option>
                <option value="completed">تم التنفيذ بنجاح (Completed)</option>
                <option value="closed">مغلق (Closed)</option>
              </select>
            </div>
            <div style="margin-bottom: 20px;">
              <label style="display: block; color: #888; font-size: 0.85rem; margin-bottom: 6px;">ملاحظات الإدارة</label>
              <textarea name="admin_notes" id="modalAdminNotes" rows="3" style="width: 100%; background: #141a16; border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 10px; border-radius: 10px; font-size: 0.9rem;" placeholder="اكتب ما تم مع العميل..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
              <button type="button" onclick="closeStatusModal()" style="background: rgba(255,255,255,0.1); color: #fff; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer;">إلغاء</button>
              <button type="submit" style="background: var(--primary-gold, #c79a52); color: #000; font-weight: 700; border: none; padding: 8px 20px; border-radius: 8px; cursor: pointer;">حفظ التغيير</button>
            </div>
          </form>
        </div>
      </div>

      <script>
        function openStatusModal(id, reqId, status, notes) {
          document.getElementById('modalTitle').textContent = 'تعديل حالة التذكرة: ' + reqId;
          document.getElementById('modalStatusForm').action = '/admin/najm/requests/' + id + '/status';
          document.getElementById('modalStatusSelect').value = status;
          document.getElementById('modalAdminNotes').value = notes || '';
          document.getElementById('statusModal').style.display = 'flex';
        }
        function closeStatusModal() {
          document.getElementById('statusModal').style.display = 'none';
        }
      </script>
    <% } %>

    <!-- 5. CONVERSATIONS VIEW -->
    <% if (view === 'conversations') { %>
      <div class="glass-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px;">
        <h2 style="color: #fff; font-size: 1.3rem; margin-top: 0; margin-bottom: 20px;">محادثات العملاء الحية مع نجم</h2>
        <div class="table-responsive">
          <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: right;">
                <th style="padding: 12px; color: #888;">معرف الجلسة</th>
                <th style="padding: 12px; color: #888;">عنوان المحادثة</th>
                <th style="padding: 12px; color: #888;">عدد الرسائل</th>
                <th style="padding: 12px; color: #888;">آخر تفاعل</th>
                <th style="padding: 12px; color: #888; text-align: center;">معاينة</th>
              </tr>
            </thead>
            <tbody>
              <% if (conversations.length === 0) { %>
                <tr><td colspan="5" style="text-align: center; padding: 40px; color: #888;">لا توجد محادثات مسجلة حتى الآن.</td></tr>
              <% } %>
              <% conversations.forEach(c => { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td style="padding: 12px; font-family: monospace; color: #888;"><%= c.session_id %></td>
                  <td style="padding: 12px; color: #fff; font-weight: 600;"><%= c.title %></td>
                  <td style="padding: 12px; color: var(--primary-gold, #c79a52); font-weight: 700;"><%= c.message_count %></td>
                  <td style="padding: 12px; color: #888;"><%= helpers.formatDateTime(c.updated_at) %></td>
                  <td style="padding: 12px; text-align: center;">
                    <button type="button" onclick="viewChatTranscript('<%= c.id %>', '<%= (c.title || '').replace(/'/g, "\'") %>')" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; cursor: pointer;">
                      عرض التفريغ
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Transcript Drawer -->
      <div id="transcriptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #18201b; border: 1px solid var(--primary-gold, #c79a52); border-radius: 16px; padding: 24px; width: 100%; max-width: 600px; max-height: 80vh; display: flex; flex-direction: column;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">
            <h3 style="color: #fff; margin: 0;" id="transcriptTitle">تفريغ المحادثة</h3>
            <button onclick="closeTranscriptModal()" style="background: none; border: none; color: #888; font-size: 1.4rem; cursor: pointer;">&times;</button>
          </div>
          <div id="transcriptMessagesList" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 10px 0;"></div>
        </div>
      </div>

      <script>
        async function viewChatTranscript(convId, title) {
          document.getElementById('transcriptTitle').textContent = title || 'تفريغ المحادثة';
          const list = document.getElementById('transcriptMessagesList');
          list.innerHTML = '<div style="color:#888; text-align:center; padding:20px;">جارٍ جلب الرسائل...</div>';
          document.getElementById('transcriptModal').style.display = 'flex';

          try {
            const res = await fetch('/admin/najm/conversations/' + convId + '/messages');
            const data = await res.json();
            if (data.messages && data.messages.length) {
              list.innerHTML = data.messages.map(m => {
                const isUser = m.sender === 'user';
                return '<div style="align-self: ' + (isUser ? 'flex-start' : 'flex-end') + '; background: ' + (isUser ? 'rgba(255,255,255,0.06)' : 'rgba(199,154,82,0.15)') + '; border: 1px solid ' + (isUser ? 'rgba(255,255,255,0.1)' : 'rgba(199,154,82,0.3)') + '; border-radius: 12px; padding: 10px 14px; max-width: 85%;">' +
                  '<div style="font-size: 0.75rem; color: ' + (isUser ? '#888' : 'var(--primary-gold, #c79a52)') + '; font-weight:700; margin-bottom:4px;">' + (isUser ? 'العميل' : 'نجم') + '</div>' +
                  '<div style="color:#fff; font-size:0.9rem; line-height:1.5;">' + m.content + '</div>' +
                '</div>';
              }).join('');
            } else {
              list.innerHTML = '<div style="color:#888; text-align:center; padding:20px;">لا توجد رسائل مسجلة.</div>';
            }
          } catch (e) {
            list.innerHTML = '<div style="color:#ef4444; text-align:center; padding:20px;">تعذر تحميل الرسائل: ' + e.message + '</div>';
          }
        }
        function closeTranscriptModal() {
          document.getElementById('transcriptModal').style.display = 'none';
        }
      </script>
    <% } %>

    <!-- 6. TOOLS VIEW -->
    <% if (view === 'tools') { %>
      <div class="glass-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px;">
        <h2 style="color: #fff; font-size: 1.3rem; margin-top: 0; margin-bottom: 8px;">أدوات المتجر الحقيقية المفعلة لنجم (Store Tools)</h2>
        <p style="color: #888; font-size: 0.9rem; margin-bottom: 24px;">هذه الأدوات تنفذ العمليات الحقيقية على قاعدة بيانات SQLite مباشرة دون أي اختلاق للبيانات.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
          <% tools.forEach(t => { %>
            <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 16px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <code style="color: var(--primary-gold, #c79a52); font-weight: 700; font-size: 0.95rem;"><%= t.name %></code>
                <span style="background: rgba(34,197,94,0.15); color: #22c55e; font-size: 0.72rem; padding: 2px 8px; border-radius: 10px; font-weight: 700;">جاهزة ومفعلة</span>
              </div>
              <p style="color: rgba(255,255,255,0.75); font-size: 0.85rem; margin: 0 0 10px 0; line-height: 1.4;"><%= t.description %></p>
              <% if (t.parameters && t.parameters.properties) { %>
                <div style="background: rgba(0,0,0,0.2); padding: 8px; border-radius: 8px; font-size: 0.75rem; color: #888;">
                  <strong>المدخلات:</strong> <%= Object.keys(t.parameters.properties).join(', ') %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- 7. AUDITS VIEW -->
    <% if (view === 'audits') { %>
      <div class="glass-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px;">
        <h2 style="color: #fff; font-size: 1.3rem; margin-top: 0; margin-bottom: 20px;">سجل العمليات الحساسة لنجم (Action Audit Log)</h2>
        <div class="table-responsive">
          <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: right;">
                <th style="padding: 12px; color: #888;">الإجراء</th>
                <th style="padding: 12px; color: #888;">الهدف</th>
                <th style="padding: 12px; color: #888;">النتيجة</th>
                <th style="padding: 12px; color: #888;">البيانات</th>
                <th style="padding: 12px; color: #888;">التاريخ</th>
              </tr>
            </thead>
            <tbody>
              <% if (actionAudits.length === 0) { %>
                <tr><td colspan="5" style="text-align: center; padding: 40px; color: #888;">لا توجد سجلات تدقيق حتى الآن.</td></tr>
              <% } %>
              <% actionAudits.forEach(a => { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td style="padding: 12px; color: var(--primary-gold, #c79a52); font-weight: 700;"><%= a.action %></td>
                  <td style="padding: 12px; color: #fff;"><%= a.target_type %>: <%= a.target_id %></td>
                  <td style="padding: 12px;">
                    <span style="font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; font-weight: 700; background: <%= a.result === 'success' ? 'rgba(34,197,94,0.15)' : 'rgba(239,68,68,0.15)' %>; color: <%= a.result === 'success' ? '#22c55e' : '#ef4444' %>;">
                      <%= a.result %>
                    </span>
                  </td>
                  <td style="padding: 12px; color: #888; font-family: monospace; font-size: 0.78rem; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= typeof a.payload === 'object' ? JSON.stringify(a.payload) : a.payload %></td>
                  <td style="padding: 12px; color: #888; font-size: 0.85rem;"><%= helpers.formatDateTime(a.created_at) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>
</main>

