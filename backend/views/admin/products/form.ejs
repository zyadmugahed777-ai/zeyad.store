<script>
  // Both of these are called by the selects above and were never defined, so
  // the dependent fields never reacted to a change.
  function toggleProductDeliveryFields(value) {
    var box = document.getElementById('product_fixed_delivery_div');
    if (box) box.style.display = (value === 'fixed') ? 'block' : 'none';
  }

  function toggleInstallationFeeField(value) {
    var box = document.getElementById('product_installation_fee_div');
    if (box) box.style.display = (String(value) === '1') ? 'block' : 'none';
  }

  // Apply the saved product's own values on load, so opening an existing
  // product shows the right fields without waiting for a change event.
  document.addEventListener('DOMContentLoaded', function () {
    var d = document.getElementById('product_delivery_policy_type');
    if (d) toggleProductDeliveryFields(d.value);
    var i = document.getElementById('product_requires_installation');
    if (i) toggleInstallationFeeField(i.value);
  });
</script>
