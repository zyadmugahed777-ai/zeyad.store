<%- include('../../partials/head', { title }) %>
<%- include('../../partials/sidebar', { active }) %>
<main class="admin-main">
  <%- include('../../partials/topbar') %>
  <div class="admin-content">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="page-title"><%= title %></h1>
      <a href="/admin/orders" class="btn btn-outline">
        <span class="material-symbols-rounded">arrow_forward</span>
        العودة للقائمة
      </a>
    </div>

    <div class="row" style="display: flex; flex-wrap: wrap; margin: -12px;">
      
      <!-- تفاصيل الطلب والمنتجات -->
      <div style="flex: 0 0 66.66%; padding: 12px; box-sizing: border-box;">
        <div class="glass-card mb-4">
          <h2 style="font-size: 1.1rem; margin-bottom: 20px; color: var(--primary-color);">المنتجات المطلوبة</h2>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th style="width: 60px;">الصورة</th>
                  <th>المنتج والخيارات</th>
                  <th class="text-center">السعر</th>
                  <th class="text-center">الكمية</th>
                  <th class="text-center">الإجمالي</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach(item => { %>
                  <% 
                    let imgSrc = item.image_url || '/assets/placeholder.svg';
                    if (!imgSrc.startsWith('/') && !imgSrc.startsWith('http') && !imgSrc.startsWith('data:')) {
                      imgSrc = '/' + imgSrc;
                    }
                  %>
                  <tr>
                    <td style="vertical-align: middle;">
                      <div style="width: 52px; height: 52px; border-radius: 8px; overflow: hidden; background: var(--bg-hover, #1e293b); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); display: flex; align-items: center; justify-content: center;">
                        <img src="<%= imgSrc %>" alt="<%= item.product_title %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/assets/placeholder.svg';">
                      </div>
                    </td>
                    <td style="vertical-align: middle;">
                      <div style="display: flex; flex-direction: column; gap: 4px;">
                        <strong style="font-size: 14px; color: var(--text-main, #f8fafc);"><%= item.product_title %></strong>
                        <% if (item.selected_color) { %>
                          <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <span class="badge" style="background: rgba(199, 154, 82, 0.15); color: var(--primary-gold, #c79a52); border: 1px solid rgba(199, 154, 82, 0.3); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                              <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary-gold, #c79a52); display: inline-block;"></span>
                              اللون المختار: <%= item.selected_color %>
                            </span>
                          </div>
                        <% } %>
                        <% if (item.selected_size) { %>
                          <div style="display: inline-flex; align-items: center; gap: 6px;">
                            <span class="badge" style="background: rgba(96, 165, 250, 0.15); color: #60a5fa; border: 1px solid rgba(96, 165, 250, 0.3); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                              <span class="material-symbols-rounded" style="font-size: 12px;">straighten</span>
                              الحجم المختار: <%= item.selected_size %><% if (item.selected_size_price) { %> — <%= helpers.formatPrice(item.selected_size_price, currency, exchangeRate) %><% } %>
                            </span>
                          </div>
                        <% } %>
                        <% if (item.product_sku) { %>
                          <small class="text-muted" style="font-size: 11px;">SKU: <%= item.product_sku %></small>
                        <% } %>
                      </div>
                    </td>
                    <td class="text-center" style="vertical-align: middle;"><%= helpers.formatPrice(item.price) %></td>
                    <td class="text-center" style="vertical-align: middle;"><%= item.quantity %></td>
                    <td class="text-center" style="vertical-align: middle;"><strong><%= helpers.formatPrice(item.total) %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          
          <div class="mt-4" style="background: var(--bg-tertiary); padding: 20px; border-radius: 12px;">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">المجموع الفرعي:</span> 
              <strong><%= helpers.formatPrice(order.subtotal_sar || order.subtotal) %></strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">رسوم التوصيل:</span> 
              <strong>
                <% if (order.free_shipping || (order.shipping_fee === 0 && order.delivery_method === 'showroom_pickup')) { %>
                  <span style="color: var(--success-color, #16a34a);">مجاناً</span>
                <% } else if (order.shipping_fee && order.shipping_fee > 0) { %>
                  <%= helpers.formatPrice(order.shipping_fee_sar || order.shipping_fee) %>
                <% } else { %>
                  <span style="color: var(--accent-color, #eab308);">يحدد من قبل الإدارة</span>
                <% } %>
              </strong>
            </div>
            <% if (order.installation_fee_sar && order.installation_fee_sar > 0) { %>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">رسوم التركيب:</span> 
              <strong><%= helpers.formatPrice(order.installation_fee_sar) %></strong>
            </div>
            <% } %>
            <% if ((order.discount_sar && order.discount_sar > 0) || (order.discount && order.discount > 0)) { %>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-danger">الخصم (<%= order.coupon_code || 'كوبون' %>):</span> 
              <strong class="text-danger">-<%= helpers.formatPrice(order.discount_sar || order.discount) %></strong>
            </div>
            <% } %>
            <div class="d-flex justify-content-between mt-3 pt-3" style="border-top: 1px solid var(--border-color);">
              <div>
                <span style="font-size: 1.2rem; font-weight: 700;">الإجمالي:</span>
                <% if (order.currency === 'YER') { %>
                  <div class="text-muted" style="font-size: 12px;">(المعادل بالعملة المطلوبة: <%= Number(order.total).toLocaleString('ar-YE') %> ر.ي)</div>
                <% } %>
              </div>
              <span style="font-size: 1.3rem; font-weight: 700; color: var(--primary-color);"><%= helpers.formatPrice(order.total_sar || order.total) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- معلومات العميل والحالة -->
      <div style="flex: 0 0 33.33%; padding: 12px; box-sizing: border-box;">
        
        <div class="glass-card mb-4">
          <h2 style="font-size: 1.1rem; margin-bottom: 20px; color: var(--primary-color);">تحديث الحالة</h2>
          <form action="/admin/orders/<%= order.id %>/status" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="form-group mb-3">
              <select name="status" class="form-control">
                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>في الانتظار</option>
                <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>تم التأكيد</option>
                <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>قيد التجهيز</option>
                <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>تم الشحن</option>
                <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>تم التوصيل</option>
                <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>ملغي</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
              <span class="material-symbols-rounded">update</span>
              تحديث الحالة
            </button>
          </form>
        </div>

        <div class="glass-card mb-4">
          <h2 style="font-size: 1.1rem; margin-bottom: 20px; color: var(--primary-color);">بيانات العميل</h2>
          
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div class="d-flex justify-content-between">
              <span class="text-muted">الاسم:</span>
              <strong><%= order.first_name %> <%= order.last_name || '' %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">الهاتف:</span>
              <a href="tel:<%= order.phone %>" dir="ltr" style="text-decoration: none; font-weight: 600;"><%= order.phone %></a>
            </div>
            <% if (order.email) { %>
            <div class="d-flex justify-content-between">
              <span class="text-muted">البريد الإلكتروني:</span>
              <span dir="ltr"><%= order.email %></span>
            </div>
            <% } %>
          </div>

          <div class="mt-4 pt-3" style="border-top: 1px solid var(--border-color);">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">طريقة الدفع:</span>
              <strong><%= helpers.paymentLabel(order.payment_method) %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">طريقة التوصيل:</span>
              <strong><%= order.delivery_method || '-' %></strong>
            </div>
          </div>

          <% if (order.notes) { %>
            <div class="mt-4 p-3" style="background: rgba(234, 179, 8, 0.1); border-left: 4px solid var(--accent-color); border-radius: 4px;">
              <strong style="color: var(--accent-color); display: block; margin-bottom: 5px;">ملاحظات العميل:</strong>
              <p style="margin: 0; font-size: 14px;"><%= order.notes %></p>
            </div>
          <% } %>
          
          <% if (typeof whatsappLink !== 'undefined' && whatsappLink) { %>
            <div class="mt-4">
              <a href="<%= whatsappLink %>" target="_blank" rel="noopener noreferrer" class="btn" style="background: #25D366; color: white; width: 100%; justify-content: center; text-decoration: none;">
                <span class="material-symbols-rounded">chat</span> إرسال عبر واتساب
              </a>
            </div>
          <% } %>

          <% if (order.whatsapp_message) { %>
            <div class="mt-4 p-3" style="background: rgba(148,163,184,0.08); border-radius: 8px;">
              <strong style="display: block; margin-bottom: 5px; font-size: 13px;" class="text-muted">رسالة العميل عند الطلب:</strong>
              <p style="margin: 0; font-size: 13px; white-space: pre-wrap;"><%= order.whatsapp_message %></p>
            </div>
          <% } %>
        </div>

        <!-- موقع وتوصيل العميل (Location & Delivery Snapshot) -->
        <div class="glass-card mb-4">
          <h2 style="font-size: 1.1rem; margin-bottom: 16px; color: var(--primary-color); display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-rounded" style="color: var(--primary-gold, #c79a52);">location_on</span>
            موقع وتوصيل العميل
          </h2>
          
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div class="d-flex justify-content-between">
              <span class="text-muted">المحافظة:</span>
              <strong><%= order.province || order.city || 'صنعاء' %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">المدينة:</span>
              <strong><%= order.city || '-' %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">الحي / المنطقة:</span>
              <strong><%= order.district || '-' %></strong>
            </div>
            <div class="d-flex flex-column pt-2" style="border-top: 1px solid var(--border-color);">
              <span class="text-muted mb-1">العنوان التفصيلي (Snapshot):</span>
              <span style="font-weight: 500;"><%= order.formatted_address || (order.district ? (order.district + ' - ' + (order.address_detail || '')) : (order.address_detail || '-')) %></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid var(--border-color);">
              <span class="text-muted">الإحداثيات الجغرافية:</span>
              <% if (order.latitude && order.longitude) { %>
                <span class="badge" style="background: rgba(199, 154, 82, 0.15); border: 1px solid rgba(199, 154, 82, 0.3); color: var(--primary-gold, #c79a52); font-family: monospace; font-size: 0.85rem; padding: 4px 8px; border-radius: 6px;" dir="ltr">
                  <%= Number(order.latitude).toFixed(5) %>, <%= Number(order.longitude).toFixed(5) %>
                </span>
              <% } else { %>
                <span class="text-muted" style="font-size: 0.85rem;">لم تُحدد إحداثيات</span>
              <% } %>
            </div>

            <% if (order.latitude && order.longitude) { %>
              <!-- External Map Buttons -->
              <div style="display: flex; gap: 8px; margin-top: 10px;">
                <a href="https://www.google.com/maps?q=<%= order.latitude %>,<%= order.longitude %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="flex: 1; justify-content: center; font-size: 0.82rem; padding: 8px 10px; gap: 4px;">
                  <span class="material-symbols-rounded" style="font-size: 18px;">map</span>
                  خرائط Google
                </a>
                <a href="https://www.openstreetmap.org/?mlat=<%= order.latitude %>&mlon=<%= order.longitude %>#map=16/<%= order.latitude %>/<%= order.longitude %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="flex: 1; justify-content: center; font-size: 0.82rem; padding: 8px 10px; gap: 4px;">
                  <span class="material-symbols-rounded" style="font-size: 18px;">public</span>
                  OpenStreetMap
                </a>
              </div>

              <!-- Mini Leaflet Map Preview -->
              <div class="admin-order-map-container" style="margin-top: 12px;">
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
                <style>
                  #admin-order-map .leaflet-container .leaflet-tile,
                  #admin-order-map .leaflet-tile-pane img {
                    max-width: none !important;
                    max-height: none !important;
                  }
                </style>
                <div id="admin-order-map" style="width: 100%; height: 220px; border-radius: 10px; border: 1px solid var(--border-color); background: #141b16;"></div>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
                <script>
                  document.addEventListener("DOMContentLoaded", function() {
                    const lat = <%= Number(order.latitude) %>;
                    const lng = <%= Number(order.longitude) %>;
                    const mapEl = document.getElementById("admin-order-map");
                    if (mapEl && window.L && !isNaN(lat) && !isNaN(lng)) {
                      const adminMap = L.map(mapEl, {
                        center: [lat, lng],
                        zoom: 15,
                        scrollWheelZoom: false,
                        attributionControl: false
                      });
                      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19
                      }).addTo(adminMap);
                      
                      const marker = L.marker([lat, lng]).addTo(adminMap);
                      marker.bindPopup("<strong>طلب #<%= order.order_id %></strong><br><%= (order.formatted_address || order.city || 'موقع العميل').replace(/\"/g, '&quot;') %>").openPopup();
                      
                      setTimeout(() => { adminMap.invalidateSize(); }, 200);
                    }
                  });
                </script>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>
<%- include('../../partials/foot') %>