<%- include('../../partials/head', { title }) %>
<%- include('../../partials/sidebar', { active }) %>
<main class="admin-main">
  <%- include('../../partials/topbar') %>
  <div class="admin-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="page-title"><%= title %></h1>
        <p class="text-muted" style="margin-top: 4px; font-size: 0.9rem;">
          حدد حتى 20 منتجاً للظهور في شريط العروض السريعة المتحرك (SuperDeals Carousel) في الواجهة الرئيسية.
        </p>
      </div>
      <button type="submit" form="frame-products-form" class="btn-primary" style="display: flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 12px; font-weight: 700; background: var(--primary-gold); color: #000; border: none; cursor: pointer;">
        <span class="material-symbols-rounded">save</span>
        حفظ المنتجات المختارة
      </button>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="alert alert-<%= flash.type || 'info' %> mb-4" style="padding: 12px 16px; border-radius: 12px; background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3);">
        <%= flash.message %>
      </div>
    <% } %>

    <form id="frame-products-form" action="/admin/frame-products" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="glass-card mb-4" style="background: var(--bg-secondary, #18201b); border-radius: 16px; padding: 20px; border: 1px solid rgba(255,255,255,0.08);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <h2 style="font-size: 1.1rem; color: var(--primary-gold, #c79a52); margin: 0;">
            قائمة منتجات المتجر (<%= products.length %> منتج)
          </h2>
          <span id="selected-count-badge" style="background: rgba(199,154,82,0.2); color: var(--primary-gold, #c79a52); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;">
            المحدد: <%= selectedIds.length %> / 20
          </span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">
          <% products.forEach(p => { %>
            <% const isChecked = selectedIds.includes(String(p.id)) || selectedIds.includes(String(p.product_id)); %>
            <label class="frame-product-item" style="display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 14px; background: rgba(255,255,255,0.03); border: 1px solid <%= isChecked ? 'var(--primary-gold, #c79a52)' : 'rgba(255,255,255,0.08)' %>; cursor: pointer; transition: 0.2s;">
              <input type="checkbox" name="product_ids" value="<%= p.id %>" <%= isChecked ? 'checked' : '' %> class="frame-checkbox" style="width: 18px; height: 18px; accent-color: var(--primary-gold, #c79a52);">
              <img src="<%= p.main_image || '/assets/placeholder.png' %>" alt="<%= p.title %>" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover; background: #fff;">
              <div style="flex: 1; overflow: hidden;">
                <div style="font-weight: 700; font-size: 0.88rem; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= p.title %></div>
                <div style="font-size: 0.78rem; color: var(--primary-gold, #c79a52); font-weight: 700; margin-top: 2px;"><%= p.price %> ر.ي</div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>
    </form>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = document.querySelectorAll('.frame-checkbox');
    const badge = document.getElementById('selected-count-badge');
    
    function updateCount() {
      const checked = document.querySelectorAll('.frame-checkbox:checked');
      if (badge) badge.textContent = `المحدد: ${checked.length} / 20`;
      if (checked.length >= 20) {
        checkboxes.forEach(cb => {
          if (!cb.checked) cb.disabled = true;
        });
      } else {
        checkboxes.forEach(cb => cb.disabled = false);
      }
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', (e) => {
        const item = e.target.closest('.frame-product-item');
        if (item) {
          item.style.borderColor = e.target.checked ? 'var(--primary-gold, #c79a52)' : 'rgba(255,255,255,0.08)';
        }
        updateCount();
      });
    });
    updateCount();
  });
</script>
<%- include('../../partials/foot') %>
