<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <title>تقرير بلاغ فني - <%= report.report_number %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      font-family: 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body {
      margin: 0;
      padding: 24px;
      color: #1a1a1a;
      background: #fff;
      font-size: 13.5px;
      line-height: 1.5;
    }
    .print-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 2px solid #000;
      margin-bottom: 20px;
    }
    .print-logo h1 {
      margin: 0;
      font-size: 20px;
      font-weight: 700;
    }
    .print-logo p {
      margin: 2px 0 0;
      font-size: 11.5px;
      color: #555;
    }
    .print-meta {
      text-align: left;
    }
    .print-meta strong {
      font-size: 16px;
      display: block;
      color: #111;
    }
    .print-section {
      margin-bottom: 18px;
      page-break-inside: avoid;
    }
    .section-title {
      font-size: 13.5px;
      font-weight: 700;
      background: #f3f4f6;
      padding: 5px 10px;
      border-radius: 4px;
      margin-bottom: 8px;
    }
    .grid-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 10px;
    }
    .grid-table th, .grid-table td {
      border: 1px solid #e5e7eb;
      padding: 7px 10px;
      text-align: right;
      font-size: 12.5px;
    }
    .grid-table th {
      background: #fafafa;
      width: 22%;
      color: #4b5563;
    }
    .content-box {
      border: 1px solid #e5e7eb;
      padding: 10px;
      border-radius: 4px;
      background: #fafafa;
      white-space: pre-wrap;
      font-size: 13px;
    }
    .report-image {
      max-width: 320px;
      max-height: 220px;
      border: 1px solid #e5e7eb;
      border-radius: 4px;
      object-fit: contain;
      display: block;
      margin-top: 6px;
    }
    .footer-sign {
      margin-top: 32px;
      display: flex;
      justify-content: space-between;
      page-break-inside: avoid;
    }
    .sign-box {
      width: 180px;
      text-align: center;
      border-top: 1px solid #000;
      padding-top: 6px;
      font-size: 12px;
    }
    @media print {
      body { padding: 0; }
      @page { size: A4; margin: 12mm; }
    }
  </style>
</head>
<body>

  <div class="print-header">
    <div class="print-logo">
      <h1>زياد ستور — Zeyad For Business</h1>
      <p>تقرير فحص ومتابعة بلاغ فني / أمني للموقع الإلكتروني</p>
    </div>
    <div class="print-meta">
      <strong>رقم البلاغ: <%= report.report_number %></strong>
      <span style="font-size: 11.5px; color: #666;">تاريخ الطباعة: <%= printDate %></span>
    </div>
  </div>

  <div class="print-section">
    <div class="section-title">بيانات البلاغ والعميل</div>
    <table class="grid-table">
      <tr>
        <th>اسم المُبلغ</th>
        <td><strong><%= report.customer_name || 'عميل مجهول' %></strong></td>
        <th>نوع المشكلة</th>
        <td><strong><%= report.issue_type_ar || report.issue_type %></strong></td>
      </tr>
      <tr>
        <th>رقم الهاتف</th>
        <td dir="ltr" style="text-align: right;"><%= report.customer_phone %></td>
        <th>البريد الإلكتروني</th>
        <td><%= report.customer_email || '—' %></td>
      </tr>
      <tr>
        <th>حالة البلاغ</th>
        <td><strong><%= statusMap[report.status] || report.status %></strong></td>
        <th>الأولوية</th>
        <td><%= priorityMap[report.priority] || report.priority %></td>
      </tr>
      <tr>
        <th>تاريخ البلاغ</th>
        <td><%= new Date(report.created_at).toLocaleString('ar-YE') %></td>
        <th>عنوان الصفحة (URL)</th>
        <td dir="ltr" style="text-align: right; font-size: 11px;"><%= report.page_url || '—' %></td>
      </tr>
    </table>
  </div>

  <div class="print-section">
    <div class="section-title">وصف المشكلة وتفاصيل المعاينة</div>
    <div class="content-box">
      <p style="margin: 0;"><%= report.description %></p>
    </div>
  </div>

  <% if (report.expected_behavior || report.actual_behavior) { %>
    <div class="print-section">
      <div class="section-title">السلوك المتوقع مقارنة بالسلوك الفعلي</div>
      <table class="grid-table">
        <tr>
          <th>ما كان متوقعاً</th>
          <td><%= report.expected_behavior || '—' %></td>
        </tr>
        <tr>
          <th>ما حدث فعلياً</th>
          <td><%= report.actual_behavior || '—' %></td>
        </tr>
      </table>
    </div>
  <% } %>

  <% if (contextData && Object.keys(contextData).length > 0) { %>
    <div class="print-section">
      <div class="section-title">بيانات السياق الفني الموثقة تلقائياً</div>
      <table class="grid-table">
        <% if (contextData.productId || contextData.product_id) { %>
          <tr>
            <th>المنتج المرتبط</th>
            <td><%= contextData.productTitle || contextData.product_name || 'منتج #' + (contextData.productId || contextData.product_id) %> (رمز: <%= contextData.productId || contextData.product_id %>)</td>
          </tr>
        <% } %>
        <% if (contextData.orderId || contextData.order_id) { %>
          <tr>
            <th>الطلب الشرائي المرتبط</th>
            <td><%= contextData.orderId || contextData.order_id %></td>
          </tr>
        <% } %>
        <% if (contextData.device || contextData.screen) { %>
          <tr>
            <th>الجهاز والشاشة</th>
            <td><%= contextData.device || 'متصفح' %> — <%= contextData.screen || '' %></td>
          </tr>
        <% } %>
      </table>
    </div>
  <% } %>

  <% if (report.image_path) { %>
    <div class="print-section">
      <div class="section-title">صورة الدليل / لقطة الشاشة</div>
      <img src="<%= report.image_path %>" class="report-image" alt="Evidence">
    </div>
  <% } %>

  <% if (report.reward_status === 'approved') { %>
    <div class="print-section">
      <div class="section-title">المكافأة المعتمدة</div>
      <table class="grid-table">
        <tr>
          <th>قيمة المكافأة</th>
          <td><strong><%= report.reward_type === 'percentage' ? `${report.reward_value}%` : `${report.reward_value} ر.ي` %></strong></td>
          <th>كود الكوبون</th>
          <td style="font-family: monospace; font-size: 14px; font-weight: 700;"><%= report.reward_code %></td>
        </tr>
      </table>
    </div>
  <% } %>

  <% if (report.admin_notes) { %>
    <div class="print-section">
      <div class="section-title">ملاحظات الإدارة والفريق الفني</div>
      <div class="content-box">
        <%= report.admin_notes %>
      </div>
    </div>
  <% } %>

  <div class="footer-sign">
    <div class="sign-box">
      <span>توقيع مسؤول الصيانة / البرمجة</span>
    </div>
    <div class="sign-box">
      <span>اعتماد الإدارة الفنية</span>
    </div>
  </div>

  <script>
    window.addEventListener('load', () => {
      setTimeout(() => { window.print(); }, 400);
    });
  </script>
</body>
</html>
